<aside class="hud-sidebar" id="hudSidebar">
    @{
        var isPosRoute = (Context.Request.Path.Value?.ToLower() ?? "").StartsWith("/pos");
    }
    @if (isPosRoute)
    {
        <!-- ====================================================================
             POS TACTICAL OPERATIONS SIDEBAR (EXCLUSIVE TO /POS)
             ==================================================================== -->
        <div class="hud-menu-group">
            <div class="hud-menu-category-title text-success" style="border-left: 3px solid var(--bio-emerald, #00FF66); padding-left: 10px; white-space: nowrap; overflow: hidden;">
                <span style="font-family:'Orbitron', sans-serif; font-size:0.78rem; font-weight:700; white-space: nowrap; display: block;"><i class="fa-solid fa-calculator me-2" style="color:var(--bio-emerald, #00FF66);"></i>POS OPERATIONS</span>
            </div>
            <ul class="hud-menu-list">
                <li class="hud-menu-item">
                    <a class="hud-menu-link pos-side-nav active" href="javascript:void(0)" id="sidebarNavPos" onclick="switchMainView('pos', this)" style="border-left: 2px solid var(--holo-cyan, #00E5FF); display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-cash-register" style="color:#00E5FF; font-size:1.05rem; flex-shrink: 0;"></i>
                        <span class="hud-menu-text" style="font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; color:#FFF; white-space: nowrap;">POS STATION</span>
                    </a>
                </li>
                <li class="hud-menu-item">
                    <a class="hud-menu-link pos-side-nav" href="javascript:void(0)" id="sidebarNavToday" onclick="switchMainView('today', this)" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-list-check" style="color:#FFB000; font-size:1.05rem; flex-shrink: 0;"></i>
                        <span class="hud-menu-text" style="font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; white-space: nowrap;">ORDERS TODAY</span>
                    </a>
                </li>
                <li class="hud-menu-item">
                    <a class="hud-menu-link pos-side-nav" href="javascript:void(0)" id="sidebarNavAnalytics" onclick="switchMainView('analytics', this)" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-chart-line" style="color:#00FF66; font-size:1.05rem; flex-shrink: 0;"></i>
                        <span class="hud-menu-text" style="font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; white-space: nowrap;">ANALYTICS</span>
                    </a>
                </li>
                <li class="hud-menu-item">
                    <a class="hud-menu-link pos-side-nav" href="javascript:void(0)" id="sidebarNavCustomers" onclick="switchMainView('customers', this)" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-user-shield" style="color:#0088FF; font-size:1.05rem; flex-shrink: 0;"></i>
                        <span class="hud-menu-text" style="font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; white-space: nowrap;">VIP CUSTOMERS</span>
                    </a>
                </li>
                <li class="hud-menu-item">
                    <a class="hud-menu-link pos-side-nav" href="javascript:void(0)" id="sidebarNavShift" onclick="switchMainView('shift', this)" style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-clock" style="color:#FFB000; font-size:1.05rem; flex-shrink: 0;" id="sidebarShiftIcon"></i>
                        <span class="hud-menu-text" id="sidebarShiftText" style="font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; white-space: nowrap;">SHIFT WORKFLOW</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="hud-menu-group" style="margin-top:20px; padding-top:16px; border-top:1px dashed #222;">
            <ul class="hud-menu-list">
                <li class="hud-menu-item">
                    <a class="hud-menu-link" href="/Home/DashboardRouter" style="border-left: 3px solid #FF3333; background: rgba(255, 51, 51, 0.04); display: flex; align-items: center; gap: 12px; padding: 12px 14px; white-space: nowrap;">
                        <i class="fa-solid fa-door-open" style="color:#FF3333; font-size:1.05rem; flex-shrink: 0;"></i>
                        <span class="hud-menu-text" style="color:#FF3333; font-family:'Orbitron', sans-serif; font-size:0.82rem; font-weight:bold; white-space: nowrap;">EXIT TO PORTAL</span>
                    </a>
                </li>
            </ul>
        </div>
    }
    else
    {
    <!-- MODULE 1: SYSTEM & IAM -->
    @if (User.HasClaim("Permission", "System.Config.Manage") || User.HasClaim("Permission", "System.Tenant.Manage") || User.HasClaim("Permission", "System.Role.Manage") || User.HasClaim("Permission", "System.User.Manage") || User.HasClaim("Permission", "POS.Shift.Open"))
    {
    <div class="hud-menu-group">
        <div class="hud-menu-category-title">
            <span><i class="fa-solid fa-shield-halved me-1"></i> System & IAM</span>
            <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
        </div>
        <ul class="hud-menu-list">
            @if(User.HasClaim("Permission", "System.Tenant.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Tenants" asp-action="Index">
                    <i class="fa-solid fa-layer-group"></i>
                    <span class="hud-menu-text">Tenants</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.Role.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Roles" asp-action="Index">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span class="hud-menu-text">Roles</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Permissions" asp-action="Index">
                    <i class="fa-solid fa-key"></i>
                    <span class="hud-menu-text">Permissions</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="PermissionRoles" asp-action="Index">
                    <i class="fa-solid fa-users-gear"></i>
                    <span class="hud-menu-text">Permission Matrix</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="SystemModules" asp-action="Index">
                    <i class="fa-solid fa-cogs"></i>
                    <span class="hud-menu-text">System Modules</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.User.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Users" asp-action="Index">
                    <i class="fa-solid fa-users-gear"></i>
                    <span class="hud-menu-text">User Accounts</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.Config.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Counters" asp-action="Index">
                    <i class="fa-solid fa-desktop"></i>
                    <span class="hud-menu-text">Counters</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "POS.Shift.Open") || User.HasClaim("Permission", "POS.Shift.Close")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Shifts" asp-action="Index">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span class="hud-menu-text">Work Shifts</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.Config.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="ShiftStatuses" asp-action="Index">
                    <i class="fa-solid fa-list-check"></i>
                    <span class="hud-menu-text">Shift Statuses</span>
                </a>
            </li>
            }
        </ul>
    </div>
    }

    <!-- MODULE 2: PARTNERS & CRM -->
    @if (User.HasClaim("Permission", "System.Config.Manage") || User.HasClaim("Permission", "System.User.Manage") || User.HasClaim("Permission", "Warehouse.Supplier.Manage"))
    {
    <div class="hud-menu-group">
        <div class="hud-menu-category-title">
            <span><i class="fa-solid fa-handshake me-1"></i> Partners & CRM</span>
            <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
        </div>
        <ul class="hud-menu-list">
            @if(User.HasClaim("Permission", "System.Config.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="CustomerTypes" asp-action="Index">
                    <i class="fa-solid fa-layer-group"></i>
                    <span class="hud-menu-text">Customer Types</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.User.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Customers" asp-action="Index">
                    <i class="fa-solid fa-address-book"></i>
                    <span class="hud-menu-text">Customers</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Warehouse.Supplier.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="Suppliers" asp-action="Index">
                    <i class="fa-solid fa-truck-field"></i>
                    <span class="hud-menu-text">Suppliers</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "POS.Order.Create") || User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="Retails" asp-action="Index">
                    <i class="fa-solid fa-store-slash"></i>
                    <span class="hud-menu-text">Retail Trade Logs</span>
                </a>
            </li>
            }
        </ul>
    </div>
    }

    <!-- MODULE 3: INVENTORY & CATALOG -->
    @if (User.HasClaim("Permission", "Catalog.Category.Manage") || User.HasClaim("Permission", "Catalog.Price.Manage") || User.HasClaim("Permission", "Catalog.Product.Manage") || User.HasClaim("Permission", "Warehouse.Inventory.View") || User.HasClaim("Permission", "Warehouse.Voucher.Create"))
    {
    <div class="hud-menu-group">
        <div class="hud-menu-category-title">
            <span><i class="fa-solid fa-boxes-stacked me-1"></i> Inventory & Catalog</span>
            <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
        </div>
        <ul class="hud-menu-list">
            @if(User.HasClaim("Permission", "Catalog.Category.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="Categories" asp-action="Index">
                    <i class="fa-solid fa-folder-tree"></i>
                    <span class="hud-menu-text">Categories</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="Units" asp-action="Index">
                    <i class="fa-solid fa-scale-balanced"></i>
                    <span class="hud-menu-text">Units</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="Manufacturers" asp-action="Index">
                    <i class="fa-solid fa-industry"></i>
                    <span class="hud-menu-text">Manufacturers</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Catalog.Price.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="TaxTypes" asp-action="Index">
                    <i class="fa-solid fa-percent"></i>
                    <span class="hud-menu-text">Tax Types</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Catalog.Category.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="ProductTypes" asp-action="Index">
                    <i class="fa-solid fa-tags"></i>
                    <span class="hud-menu-text">Product Types</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="ItemNatures" asp-action="Index">
                    <i class="fa-solid fa-dna"></i>
                    <span class="hud-menu-text">Item Natures</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Catalog.Product.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Catalog" asp-controller="Products" asp-action="Index">
                    <i class="fa-solid fa-box-open"></i>
                    <span class="hud-menu-text">Products</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Warehouse.Inventory.View")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="ProductInventories" asp-action="Index">
                    <i class="fa-solid fa-warehouse"></i>
                    <span class="hud-menu-text">Product Inventories</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Warehouse.Voucher.Create")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="StockVouchers" asp-action="Index">
                    <i class="fa-solid fa-file-export"></i>
                    <span class="hud-menu-text">Stock Vouchers</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="StockVoucherDetails" asp-action="Index">
                    <i class="fa-solid fa-file-lines"></i>
                    <span class="hud-menu-text">Stock Voucher Details</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="StockTransfers" asp-action="Index">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                    <span class="hud-menu-text">Stock Transfers</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Warehouse" asp-controller="StockAudits" asp-action="Index">
                    <i class="fa-solid fa-clipboard-check"></i>
                    <span class="hud-menu-text">Stock Audits</span>
                </a>
            </li>
            }
        </ul>
    </div>
    }

    <!-- MODULE 4: SALES & BILLING -->
    @if (User.HasClaim("Permission", "System.Config.Manage") || User.HasClaim("Permission", "POS.Order.Create") || User.HasClaim("Permission", "Finance.Invoice.View"))
    {
    <div class="hud-menu-group">
        <div class="hud-menu-category-title">
            <span><i class="fa-solid fa-cart-shopping me-1"></i> Sales & Billing</span>
            <i class="fa-solid fa-chevron-down text-cyan" style="font-size:0.6rem;"></i>
        </div>
        <ul class="hud-menu-list">
            @if(User.HasClaim("Permission", "System.Config.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="OrderStatuses" asp-action="Index">
                    <i class="fa-solid fa-flag"></i>
                    <span class="hud-menu-text">Order Statuses</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="PaymentMethods" asp-action="Index">
                    <i class="fa-solid fa-credit-card"></i>
                    <span class="hud-menu-text">Payment Methods</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "POS.Order.Create")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="Orders" asp-action="Index">
                    <i class="fa-solid fa-receipt"></i>
                    <span class="hud-menu-text">Sales Orders</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="OrderDetails" asp-action="Index">
                    <i class="fa-solid fa-list-ol"></i>
                    <span class="hud-menu-text">Order Details</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "System.Config.Manage")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="InvoiceStatuses" asp-action="Index">
                    <i class="fa-solid fa-square-check"></i>
                    <span class="hud-menu-text">Invoice Statuses</span>
                </a>
            </li>
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="InvoiceTypes" asp-action="Index">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    <span class="hud-menu-text">Invoice Types</span>
                </a>
            </li>
            }
            @if(User.HasClaim("Permission", "Finance.Invoice.View")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Accountant" asp-controller="Invoices" asp-action="Index">
                    <i class="fa-solid fa-file-signature"></i>
                    <span class="hud-menu-text">Financial Invoices</span>
                </a>
            </li>
            }
            @if(User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.HasClaim("Permission", "Finance.Invoice.View")){
            <li class="hud-menu-item">
                <a class="hud-menu-link" asp-area="Administrator" asp-controller="Subscriptions" asp-action="Index">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    <span class="hud-menu-text">SaaS Subscriptions</span>
                </a>
            </li>
            }
        </ul>
    </div>
    }

    <!-- MODULE 5: LINKS & TERMINALS -->
    @if (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("POS Operator") || User.IsInRole("Catalog") || User.HasClaim("Permission", "POS.Order.Create"))
    {
    <div class="hud-menu-group">
        <div class="hud-menu-category-title text-success" style="border-color: rgba(0, 255, 102, 0.3);">
            <span><i class="fa-solid fa-link me-1"></i> Links & Terminals</span>
            <i class="fa-solid fa-chevron-down text-success" style="font-size:0.6rem;"></i>
        </div>
        <ul class="hud-menu-list">
            @if (User.IsInRole("Super Admin") || User.IsInRole("Tenant Manager") || User.IsInRole("POS Operator") || User.HasClaim("Permission", "POS.Order.Create"))
            {
            <li class="hud-menu-item">
                <a class="hud-menu-link border border-success mb-1" asp-area="" asp-controller="POS" asp-action="Index" style="box-shadow: 0 0 10px rgba(0, 255, 102, 0.15); background: rgba(0, 255, 102, 0.03);">
                    <i class="fa-solid fa-cash-register text-success"></i>
                    <span class="hud-menu-text text-success" style="font-weight: bold; letter-spacing: 1px;">Launch POS Machine</span>
                    <span class="hud-menu-badge" style="background-color: #00FF66; color: #000; border-color: #00FF66; font-weight: bold;">POS</span>
                </a>
            </li>
            }
            <li class="hud-menu-item">
                <a class="hud-menu-link border" asp-area="" asp-controller="Storefront" asp-action="Index" style="border-color: var(--primary-cyan) !important; box-shadow: 0 0 10px rgba(0, 229, 255, 0.15); background: rgba(0, 229, 255, 0.03);">
                    <i class="fa-solid fa-cart-shopping" style="color: var(--primary-cyan);"></i>
                    <span class="hud-menu-text" style="color: var(--primary-cyan); font-weight: bold; letter-spacing: 1px;">Online Storefront</span>
                    <span class="hud-menu-badge" style="background-color: #00E5FF; color: #000; border-color: #00E5FF; font-weight: bold;">WEB</span>
                </a>
            </li>
        </ul>
    </div>
    }
    }
</aside>
