<!-- ==================== VIEW 5: SHIFT RECONCILIATION & WORK LEDGER ==================== -->
<section id="viewShiftManagement" class="fullscreen-view">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid var(--pos-border); padding-bottom:10px;">
        <div>
            <h3 style="font-family:var(--font-hdr); color:var(--pos-amber); font-size:1.3rem; font-weight:700; margin:0;"><i class="fa-solid fa-clock me-2"></i>SHIFT RECONCILIATION LEDGER</h3>
            <div style="font-size:0.75rem; color:var(--pos-text-secondary); margin-top:2px;">OPERATIONAL SHIFT FLOAT AUDIT & REVENUE RECONCILIATION</div>
        </div>
        <div style="display:flex; gap:8px;">
            <button onclick="toggleShiftStatus()" id="btnModalShiftToggle" class="btn-checkout-execute" style="height:40px; font-size:0.8rem; padding:0 16px; background:#000000; border:1px solid #00FF66; color:#00FF66; font-weight:700;"><i class="fa-solid fa-power-off me-2"></i> OPEN SHIFT</button>
            <button onclick="loadShiftHistoryLedger()" class="deck-btn"><i class="fa-solid fa-rotate me-1"></i> REFRESH LEDGER</button>
        </div>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:12px; margin-bottom:20px;">
        <div class="kpi-tile" style="border-left-color:var(--pos-emerald);">
            <div class="title"><i class="fa-solid fa-signal me-1"></i>ACTIVE SHIFT STATUS</div>
            <div id="lblActiveShiftId" class="value" style="font-size:1.6rem; color:var(--pos-emerald);">NO SHIFT ONLINE</div>
        </div>
        <div class="kpi-tile">
            <div class="title"><i class="fa-solid fa-wallet me-1"></i>START CASH FLOAT (VND)</div>
            <div id="lblActiveStartCash" class="value" style="font-size:1.6rem; color:#FFF;">0 ₫</div>
        </div>
        <div class="kpi-tile" style="border-left-color:var(--pos-cyan);">
            <div class="title"><i class="fa-solid fa-calculator me-1"></i>ESTIMATED CLOSING CASH</div>
            <div id="lblActiveEndCash" class="value" style="font-size:1.6rem; color:var(--pos-cyan);">0 ₫</div>
        </div>
    </div>

    <h4 style="font-family:var(--font-hdr); font-size:0.95rem; color:#EEE; margin-bottom:12px;"><i class="fa-solid fa-list-ol me-2 text-cyan"></i>RECENT WORK SHIFTS HISTORY</h4>
    <div class="table-responsive">
        <table class="cart-table w-100" style="background:#080C10; border:1px solid var(--pos-border);">
            <thead>
                <tr>
                    <th>SHIFT ID</th>
                    <th>STATUS</th>
                    <th>TERMINAL COUNTER</th>
                    <th>OPERATOR</th>
                    <th>START TIME</th>
                    <th>END TIME</th>
                    <th style="text-align:right;">START FLOAT</th>
                    <th style="text-align:right;">CLOSING CASH</th>
                    <th style="text-align:right;">ORDERS</th>
                    <th style="text-align:right;">REVENUE GENERATED</th>
                </tr>
            </thead>
            <tbody id="shiftHistoryTableBody">
                <tr><td colspan="10" style="text-align:center; padding:30px; color:var(--pos-text-muted);">INITIALIZING SHIFT HISTORY...</td></tr>
            </tbody>
        </table>
    </div>
</section>
