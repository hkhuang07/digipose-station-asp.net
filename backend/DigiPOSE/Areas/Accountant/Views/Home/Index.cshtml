@model IEnumerable<DigiPOSE.Models.Order>
@{
    ViewData["Title"] = "Financial Accounting & Tax Settlement Dashboard";
}

<div class="cyber-panel">
    <div class="cyber-panel-header">
        <div class="cyber-panel-title">
            <i class="fa-solid fa-coins"></i> FINANCIAL ACCOUNTING & TAX SETTLEMENT HUB
        </div>
        <div class="cyber-panel-sub">
            [FISCAL REVENUE ENGINE] // TODAY'S REVENUE: <strong style="color:#00FF66;">@(((decimal)ViewBag.TodayRevenue).ToString("N0")) ₫</strong> | ORDERS TODAY: <strong style="color:#00E5FF;">@ViewBag.TodayOrdersCount</strong>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(0, 255, 102, 0.5); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #00FF66; text-transform: uppercase;">TODAY'S REVENUE (₫)</span>
                <span style="font-family:'VT323'; font-size: 2.5rem; color: #00FF66; text-shadow: 0 0 12px rgba(0,255,102,0.5);">@(((decimal)ViewBag.TodayRevenue).ToString("N0"))</span>
                <a href="@Url.Action("Index", "Orders", new { area = "Accountant" })" style="color: #00FF66; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> View POS Transactions</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(0, 229, 255, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #00E5FF; text-transform: uppercase;">ORDERS TODAY</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #00E5FF;">@ViewBag.TodayOrdersCount</span>
                <a href="@Url.Action("Index", "Orders", new { area = "Accountant" })" style="color: #00E5FF; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Daily Settlement</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(255, 215, 0, 0.5); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #FFD700; text-transform: uppercase;">FINANCIAL INVOICES</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #FFD700;">@ViewBag.TotalInvoices</span>
                <a href="@Url.Action("Index", "Invoices", new { area = "Accountant" })" style="color: #FFD700; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Manage Invoices</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(255, 110, 0, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #FF6E00; text-transform: uppercase;">RETAIL B2B VOUCHERS</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #FF6E00;">@ViewBag.TotalRetailDocs</span>
                <a href="@Url.Action("Index", "Retails", new { area = "Accountant" })" style="color: #FF6E00; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Retails Trade Ledger</a>
            </div>
        </div>
    </div>

    <h5 style="font-family:'Orbitron'; color:#00E5FF; font-size:0.95rem; margin-bottom:1rem; text-transform: uppercase; letter-spacing: 1px;">
        <i class="fa-solid fa-cash-register me-2"></i> LATEST POS SETTLED TRANSACTIONS
    </h5>
    
    <div class="table-responsive">
        <table class="table-cyber w-100">
            <thead>
                <tr>
                    <th style="width: 90px;">Order #</th>
                    <th>Invoice / Receipt</th>
                    <th>Cashier Operator</th>
                    <th>Customer / B2B Entity</th>
                    <th>Payment Method</th>
                    <th>Timestamp</th>
                    <th style="text-align: right;">Total Amount (₫)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-family:'Roboto Mono'; color:var(--primary-cyan); font-weight:bold;">#ORD-@item.OrderId</td>
                            <td style="font-family:'Roboto Mono'; color:#FFF;">@(item.InvoiceNumber ?? $"INV-{item.OrderId:D5}")</td>
                            <td style="color:#A0C0CE;">@(item.User?.UserName ?? $"Operator #{item.UserId}")</td>
                            <td style="color:#CCC;">@(item.SnapshotCustomerName ?? item.Customer?.FullName ?? "Walk-in Consumer")</td>
                            <td style="color:#888;">@(item.PaymentMethod?.MethodName ?? "Electronic Tender")</td>
                            <td style="font-family:'Roboto Mono'; font-size:0.85rem;">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td style="text-align:right; font-family:'VT323'; font-size:1.2rem; color:#00FF66;">@item.TotalAmount.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding: 2rem;">No settled transaction records found in financial audit buffer.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
