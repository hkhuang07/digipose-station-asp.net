@model DigiPOSE.Models.OrderDetail
<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title"><i class="fa-solid fa-list-ol text-cyan me-2"></i> ORDER LINE DETAILS</h5>
        <button type="button" class="btn-close-cyber" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
        <div style="background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(0, 229, 255, 0.3); padding: 1.25rem;">
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">Line ID:</div>
                <div class="col-8" style="font-family:'VT323'; font-size:1.4rem; color:#FFF;">#@Model.OrderDetailId</div>
            </div>
            <div class="row mb-3 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">Order:</div>
                <div class="col-8" style="font-family:'VT323'; font-size:1.3rem; color:#A0C0CE;">#@Model.OrderId</div>
            </div>
            <div class="row mb-3 align-items-start">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">@Html.DisplayNameFor(model => model.ProductName):</div>
                <div class="col-8" style="font-family:'Rajdhani'; font-size:1.15rem; font-weight:bold; color:#FFF; word-break:break-word;">@Model.ProductName</div>
            </div>
            <div class="row mb-2 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">@Html.DisplayNameFor(model => model.UnitName):</div>
                <div class="col-8" style="font-family:'Roboto Mono'; font-size:0.9rem; color:#CCC;">@Model.UnitName</div>
            </div>
            <div class="row mb-2 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">@Html.DisplayNameFor(model => model.Quantity):</div>
                <div class="col-8" style="color:#00FF66; font-family:'VT323'; font-size:1.4rem;">@Model.Quantity</div>
            </div>
            <div class="row mb-2 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">Unit Price:</div>
                <div class="col-8" style="color:#FFB000; font-family:'VT323'; font-size:1.3rem;">@string.Format("{0:N0}", Model.UnitPrice) VNĐ</div>
            </div>
            <div class="row mb-2 align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">Discount / Tax:</div>
                <div class="col-8" style="font-family:'Roboto Mono'; font-size:0.85rem; color:#A0C0CE;">@string.Format("{0:N0}", Model.DiscountAmount) (-@Model.DiscountRate%) / @string.Format("{0:N0}", Model.TaxAmount) (@Model.TaxRate%)</div>
            </div>
            <div class="row mb-3 pt-2 align-items-center" style="border-top: 1px dashed rgba(0, 229, 255, 0.3);">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.85rem; font-weight:bold; text-transform:uppercase;">Total Amount:</div>
                <div class="col-8" style="color:#00FF66; font-family:'VT323'; font-size:1.5rem; font-weight:bold;">@string.Format("{0:N0}", Model.TotalAmount) VNĐ</div>
            </div>
            <div class="row align-items-center">
                <div class="col-4" style="color:#00E5FF; font-family:'Orbitron'; font-size:0.75rem; text-transform:uppercase;">Free Item?:</div>
                <div class="col-8" style="font-family:'Roboto Mono'; font-size:0.9rem; color:#FFF;">@(Model.IsFree ? "YES" : "NO")</div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn-cyber-cancel" data-bs-dismiss="modal" style="border-top: 1px solid aliceblue !important; border-bottom: 1px solid aliceblue !important; border-left: none !important; border-right: none !important; color: aliceblue !important; background: #222222 !important;"><i class="fa-solid fa-xmark me-1"></i> CLOSE</button>
    </div>
</div>

