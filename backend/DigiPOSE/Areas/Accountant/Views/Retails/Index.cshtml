@model IEnumerable<DigiPOSE.Models.Retail>
@{ ViewData["Title"] = "Retail Documents"; }
<div class="cyber-panel">
    <div class="cyber-panel-header">
        <div class="cyber-panel-title"><i class="fa-solid fa-file-invoice"></i> RETAIL DOCUMENTS</div>
        <div class="cyber-panel-sub">[ACCOUNTING MODULE] // IMMUTABLE POS TRADE RECORDS</div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn-cyber-primary btn-show-modal" data-url="@Url.Action("Create", "Retails")"><i class="fa-solid fa-plus me-1"></i> CREATE NEW DOCUMENT</button>
            <a href="@Url.Action("ExportExcel", "Retails")" class="btn-cyber-info btn-export-excel" style="text-decoration:none;"><i class="fa-solid fa-file-excel me-1"></i> EXPORT EXCEL</a>
        </div>
        <div style="font-family:'Roboto Mono'; font-size:0.85rem; color:#00E5FF; white-space:nowrap;">TOTAL RECORDS: <strong id="totalRecordsCount" style="color:#FFF; font-family:'VT323'; font-size:1.3rem;">--</strong></div>
    </div>
    <div class="table-responsive">
        <table id="datatable" class="table-cyber w-100">
            <thead>
                <tr>
                    <th style="width:5%; text-align:center;">#</th>
                    <th>Doc No</th>
                    <th>Retail No</th>
                    <th>Type</th>
                    <th>Tenant</th>
                    <th>Buyer</th>
                    <th>Payment</th>
                    <th style="text-align:right;">Total (₫)</th>
                    <th>Date</th>
                    <th style="width:100px; text-align:center;">ACTIONS</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<div class="modal fade modal-cyber" id="globalModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:900px;" id="globalModalContainer"></div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function(){
            var table = $('#datatable').DataTable({
                serverSide: true, processing: true, filter: true,
                ajax: { url: '@Url.Action("Index_LoadData", "Retails")', type: "POST", dataType: "JSON" },
                order: [[8, 'desc']],
                columns: [
                    { data: null, name: null, sortable: false, render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { data: 'docNo', name: 'DocNo', render: d => `<span style="color:var(--primary-cyan); font-family:'Roboto Mono'; font-size:0.82rem; font-weight:bold;">${d}</span>` },
                    { data: 'retailNo', name: 'RetailNo', render: d => `<span style="color:#888; font-size:0.8rem;">${d}</span>` },
                    { data: 'docType', name: 'DocType', render: d => d === 'B2B_INVOICE' ? '<span class="badge bg-warning text-dark">B2B</span>' : '<span class="badge bg-info text-dark">POS</span>' },
                    { data: 'tenantName', name: 'TenantName' },
                    { data: 'buyerName', name: 'BuyerName', render: d => `<span style="color:#CCC;">${d}</span>` },
                    { data: 'paymentMethod', name: 'PaymentMethod', render: d => `<span style="color:#888;">${d}</span>` },
                    { data: 'totalAmount', name: 'TotalAmount', render: d => `<span style="color:#00FF66; font-family:'VT323'; font-size:1.1rem; float:right;">${$.fn.dataTable.render.number(',', '.', 0, '').display(d)}</span>` },
                    { data: 'endDate', name: 'EndDate', render: d => `<span style="color:#A0C0CE; font-family:'Roboto Mono'; font-size:0.82rem;">${d}</span>` },
                    { data: null, searchable: false, orderable: false, render: function(d,t,r){
                        var editUrl = '@Url.Action("Edit", "Retails")/' + r.retailId;
                        var detailsUrl = '@Url.Action("Details", "Retails")/' + r.retailId;
                        var deleteUrl = '@Url.Action("Delete", "Retails")/' + r.retailId;
                        return '<div style="text-align:center; white-space:nowrap;">'
                             + '<button type="button" class="btn-cyber-primary btn-show-modal" data-url="' + editUrl + '" style="padding:4px 8px; font-size:0.75rem;" title="Edit"><i class="fa-solid fa-pen"></i></button> '
                             + '<button type="button" class="btn-cyber-info btn-show-modal" data-url="' + detailsUrl + '" style="padding:4px 8px; font-size:0.75rem;" title="Details"><i class="fa-solid fa-circle-info"></i></button> '
                             + '<button type="button" class="btn-cyber-danger btn-show-modal" data-url="' + deleteUrl + '" style="padding:4px 8px; font-size:0.75rem;" title="Delete"><i class="fa-solid fa-trash"></i></button>'
                             + '</div>';
                    }}
                ],
                drawCallback: function(settings) {
                    var json = this.api().ajax.json();
                    if (json && json.recordsTotal !== undefined) $('#totalRecordsCount').text(json.recordsTotal);
                }
            });
        });
    </script>
}
