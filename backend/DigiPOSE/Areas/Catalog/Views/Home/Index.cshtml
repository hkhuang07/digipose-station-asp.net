@model IEnumerable<DigiPOSE.Models.Product>
@{
    ViewData["Title"] = "Catalog Management Dashboard";
}

<div class="cyber-panel">
    <div class="cyber-panel-header">
        <div class="cyber-panel-title">
            <i class="fa-solid fa-boxes-stacked"></i> CATALOG & INVENTORY TAXONOMY DASHBOARD
        </div>
        <div class="cyber-panel-sub">
            [PRODUCT METADATA ENGINE] // MASTER ITEMS ONLINE: <strong style="color:#00FF66;">@ViewBag.TotalProducts</strong> | CATEGORIES: <strong style="color:#00E5FF;">@ViewBag.TotalCategories</strong>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(0, 229, 255, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #00E5FF; text-transform: uppercase;">TOTAL PRODUCTS</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #00E5FF;">@ViewBag.TotalProducts</span>
                <a href="@Url.Action("Index", "Products", new { area = "Catalog" })" style="color: #00E5FF; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Manage Products</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(0, 255, 102, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #00FF66; text-transform: uppercase;">CATEGORIES</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #00FF66;">@ViewBag.TotalCategories</span>
                <a href="@Url.Action("Index", "Categories", new { area = "Catalog" })" style="color: #00FF66; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> View Taxonomy</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(255, 176, 0, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #FFB000; text-transform: uppercase;">MANUFACTURERS</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #FFB000;">@ViewBag.TotalManufacturers</span>
                <a href="@Url.Action("Index", "Manufacturers", new { area = "Catalog" })" style="color: #FFB000; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Manage Brands</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="hud-module-card" style="background: rgba(10, 10, 10, 0.9); border: 1px solid rgba(0, 136, 255, 0.4); padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; height: 140px;">
                <span style="font-family:'Orbitron'; font-size: 0.75rem; color: #0088FF; text-transform: uppercase;">MEASUREMENT UNITS</span>
                <span style="font-family:'VT323'; font-size: 2.8rem; color: #FFFFFF; text-shadow: 0 0 10px #0088FF;">@ViewBag.TotalUnits</span>
                <a href="@Url.Action("Index", "Units", new { area = "Catalog" })" style="color: #0088FF; font-size: 0.8rem; text-decoration: none;"><i class="fa-solid fa-arrow-right me-1"></i> Configure Units</a>
            </div>
        </div>
    </div>

    <h5 style="font-family:'Orbitron'; color:#00E5FF; font-size:0.95rem; margin-bottom:1rem; text-transform: uppercase; letter-spacing: 1px;">
        <i class="fa-solid fa-clock-rotate-left me-2"></i> RECENTLY cataloged PRODUCTS DEPLOYMENT
    </h5>
    
    <div class="table-responsive">
        <table class="table-cyber w-100">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Manufacturer</th>
                    <th>Unit</th>
                    <th style="text-align: right;">List Price (₫)</th>
                    <th style="text-align: center;">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-family:'Roboto Mono'; color:var(--primary-cyan); font-weight:bold;">#@item.ProductId</td>
                            <td style="font-weight: bold; color: #FFF;">@item.ProductName</td>
                            <td>@(item.Category?.CategoryName ?? "General")</td>
                            <td style="color:#A0C0CE;">@(item.Manufacturer?.ManufacturerName ?? "OEM")</td>
                            <td>@(item.Unit?.UnitName ?? "Pcs")</td>
                            <td style="text-align:right; font-family:'VT323'; font-size:1.2rem; color:#00FF66;">@item.BasePrice.ToString("N0")</td>
                            <td style="text-align:center;">
                                <span class="badge bg-success text-dark" style="font-family:'Rajdhani'; font-weight:bold;">ACTIVE</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted" style="padding: 2rem;">No items currently listed in product catalog.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
